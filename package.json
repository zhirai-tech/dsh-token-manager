{
  "name": "dsh-token-manager",
  "version": "1.3.3",
  "private": false,
  "description": "DSH Token Manager — Token 成本监控、模型调用效率分析与上下文优化（DeepSeek Harness Cordis 插件）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md"
  ],
  "author": "ZHIRAI <xtang3125@gmail.com> (https://zhirai.cloud)",
  "homepage": "https://github.com/zhirai-tech/dsh-token-manager#readme",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build-tests.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-tests.mjs && node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node scripts/build-tests.mjs && node --test \"tests/integration/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhirai-tech/dsh-token-manager.git"
  },
  "bugs": {
    "url": "https://github.com/zhirai-tech/dsh-token-manager/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tokens",
    "cost",
    "monitoring",
    "cache",
    "observability"
  ]
}
