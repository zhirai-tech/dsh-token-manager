{
  "name": "dsh-token-manager",
  "version": "1.4.0",
  "private": true,
  "description": "智控引擎 ControlX (ControlX) — AI Resource Optimization Engine：面向 AI Agent 的智能资源调度与效率优化引擎：按需推理、上下文精简、缓存复用与智能调度。（DeepSeek Harness Cordis 插件，内部包名保持不变）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "docs/**"
  ],
  "author": "ZHIRAI <xtang3125@gmail.com> (https://zhirai.cloud)",
  "homepage": "https://zhirai.cloud",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build-tests.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-tests.mjs && node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node scripts/build-tests.mjs && node --test \"tests/integration/*.test.mjs\"",
    "brand": "node scripts/release/brand-sync.mjs",
    "brand:check": "node scripts/release/brand-sync.mjs --check",
    "dist": "node scripts/release/build-dist.mjs",
    "release:check": "node scripts/release/preflight.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "controlx",
    "zhikong",
    "ai-resource-optimization",
    "adaptive-reasoning",
    "context-optimization",
    "deepseek-harness",
